#!/usr/bin/env node
/**
 * Fake `claude` CLI stub for SC-008 integration tests.
 *
 * TEST FIXTURE, not the real Claude CLI. The Claude provider's STREAMING path goes
 * through the `@anthropic-ai/claude-agent-sdk` (which manages its own subprocess), so
 * the only directly-spawned surface this stub can stand in for is `status()`
 * (`claude --version`). It validates the real spawn/exit-code path of detection.
 *
 * Behavior:
 *   --version → print a version line and exit 0 (available).
 *   If FAKE_CLI_ENV_OUT is set, record the observed billing-env keys for assertion.
 */
const fs = require('node:fs')

const argv = process.argv.slice(2)

if (process.env.FAKE_CLI_ENV_OUT) {
  fs.writeFileSync(
    process.env.FAKE_CLI_ENV_OUT,
    JSON.stringify({
      ANTHROPIC_API_KEY: process.env.ANTHROPIC_API_KEY ?? null,
      ANTHROPIC_AUTH_TOKEN: process.env.ANTHROPIC_AUTH_TOKEN ?? null,
      argv,
    })
  )
}

if (argv[0] === '--version') {
  process.stdout.write('claude 1.2.3 (fake stub)\n')
  process.exit(0)
}

process.exit(0)
