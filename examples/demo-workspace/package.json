{
  "name": "suisui-demo-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "A self-contained SuiSui demo workspace with a local website to record and run BDD tests against.",
  "scripts": {
    "serve": "node server.mjs",
    "test": "bddgen && playwright test",
    "test:ui": "bddgen && playwright test --ui",
    "test:headed": "bddgen && playwright test --headed",
    "test:debug": "bddgen && playwright test --debug",
    "bddgen": "bddgen",
    "bddgen:export": "bddgen export"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "playwright-bdd": "^8.0.0"
  }
}