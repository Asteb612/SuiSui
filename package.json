{
  "name": "suisui",
  "version": "0.1.0",
  "private": true,
  "description": "Visual BDD Test Builder for Playwright - Create Gherkin scenarios with drag-and-drop",
  "keywords": [
    "bdd",
    "gherkin",
    "playwright",
    "playwright-bdd",
    "cucumber",
    "testing",
    "e2e",
    "electron",
    "visual-testing",
    "test-builder",
    "behavior-driven-development",
    "desktop-app"
  ],
  "homepage": "https://asteb612.github.io/SuiSui/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asteb612/SuiSui.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @suisui/desktop dev",
    "build": "pnpm --filter @suisui/desktop build",
    "clean": "pnpm --filter @suisui/desktop clean",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @suisui/shared test",
    "test:e2e": "pnpm --filter @suisui/desktop test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.31.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.61.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@parcel/watcher",
      "keytar"
    ],
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1",
      "@tootallnate/once": ">=2.0.1",
      "@xmldom/xmldom": ">=0.8.13",
      "ajv@6": "6.15.0",
      "axios": ">=1.16.0",
      "brace-expansion": ">=2.0.3",
      "defu": ">=6.1.5",
      "flatted": ">=3.4.2",
      "follow-redirects": ">=1.16.0",
      "ip-address": ">=10.1.1",
      "js-cookie": ">=3.0.7",
      "lodash": ">=4.18.0",
      "minimatch": ">=10.2.3",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.10",
      "rollup": ">=4.59.0",
      "shell-quote": ">=1.8.4",
      "tar": ">=7.5.11",
      "tmp": ">=0.2.6",
      "vite": ">=7.3.2",
      "ws": ">=8.20.1"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
